# OpenAI API key (required)
OPENAI_API_KEY=sk-your-key-here

# Model to use (gpt-4o-mini is fast and cost-effective for triage)
OPENAI_MODEL=gpt-4o-mini

# Paths (defaults work for local development)
SAMPLE_MESSAGES_PATH=data/sample_messages.json
OUTPUT_DIR=data/output

# Gmail (optional — for inbox monitoring and outbox tone scanning)
GMAIL_CREDENTIALS_PATH=credentials/google_credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json
TONE_EXAMPLES_PATH=data/tone_examples.json
